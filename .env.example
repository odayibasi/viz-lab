# Bu dosyayı .env olarak kopyala (git'e girmez).
# Fine-grained personal access token: Settings → Developer settings → Personal access tokens
# İzin olarak "Public repositories (read-only)" yeterli. Boş bırakırsan API örnek veriyle çalışır.
GITHUB_TOKEN=

# npm run snapshot için hangi kullanıcının verisi alınacak
GITHUB_LOGIN=

# Backend ayarları
PORT=8787
CACHE_TTL_SECONDS=600
CACHE_DIR=.cache

# Frontend: deneylerin varsayılan kullanıcısı ve (production'da) backend adresi
VITE_DEFAULT_USER=
VITE_API_URL=
