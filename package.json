{
  "name": "viz-lab",
  "version": "0.2.0",
  "private": true,
  "description": "GitHub verisi üzerinde görselleştirme denemeleri: TypeScript backend + D3/ECharts frontend",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @viz/api",
    "dev:web": "npm run dev -w @viz/web",
    "start:api": "npm run start -w @viz/api",
    "build": "npm run typecheck && npm run build -w @viz/web",
    "snapshot": "node --env-file-if-exists=.env --import tsx scripts/snapshot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
